# Storefront database — products, orders, checkout
DB_HOST=localhost
DB_NAME=db_shopping_cart
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Accounts database — admin_login, registered user accounts
# (this is a SEPARATE database from DB_NAME above; same server/user/pass)
DB_AUTH_NAME=farmer
